{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (((!data.exists() || data.child('createdAt').val() < now - 43200000) && newData.child('hostId').val() === auth.uid && newData.child('players').child(auth.uid).exists()) || (newData.exists() && newData.child('class').isString() && $room.beginsWith(newData.child('class').val() + '-') && root.child('ownerClaims').child(newData.child('class').val()).child(auth.uid).exists() && (!data.exists() || (data.child('class').isString() && root.child('ownerClaims').child(data.child('class').val()).child(auth.uid).exists()) || data.child('createdAt').val() < now - 43200000)) || (!newData.exists() && data.child('class').isString() && root.child('ownerClaims').child(data.child('class').val()).child(auth.uid).exists()))",
        ".validate": "$room.matches(/^[A-Z]{4}$/) || newData.child('class').isString()",
        "hostId": {
          ".write": "auth != null && (data.val() === auth.uid || (newData.val() === auth.uid && !data.parent().child('class').exists() && root.child('rooms').child($room).child('players').child(auth.uid).child('online').val() === true && root.child('rooms').child($room).child('players').child(data.val()).child('online').val() !== true) || (newData.val() === auth.uid && data.parent().child('class').isString() && root.child('ownerClaims').child(data.parent().child('class').val()).child(auth.uid).exists()))"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "class": {
          ".validate": "newData.isString()"
        },
        "group": {
          ".validate": "newData.isNumber()"
        },
        "phase": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'result'"
        },
        "settings": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "drawSec": {
            ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 180"
          },
          "guessSec": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 120"
          },
          "guessMode": {
            ".validate": "newData.val() === 'free' || newData.val() === 'tiles' || newData.val() === 'choice'"
          },
          "hints": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "tiles": {
            ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 20"
          }
        },
        "order": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "round": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "roundKey": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "assign": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "deadline": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "resultView": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "startRequest": {
          ".write": "auth != null && (data.parent().child('hostId').val() === auth.uid || (newData.exists() && newData.child('by').val() === auth.uid && data.parent().child('players').child(auth.uid).exists() && (data.parent().child('phase').val() === 'lobby' || data.parent().child('phase').val() === 'result') && !root.child('rooms').child($room).child('banned').child(auth.uid).exists() && data.parent().child('class').isString() && root.child('classes').child(data.parent().child('class').val()).child('leaderStart').val() === true))",
          ".validate": "newData.hasChildren(['by', 'at']) && newData.child('at').isNumber()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !root.child('rooms').child($room).child('banned').child(auth.uid).exists() && (data.exists() || root.child('rooms').child($room).child('phase').val() === 'lobby')) || (!newData.exists() && root.child('rooms').child($room).child('hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "offAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "books": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "$b": {
            "word": {
              ".write": "auth != null && root.child('rooms').child($room).child('roundKey').val() === '0' && root.child('rooms').child($room).child('assign').child(auth.uid).val() === $b && root.child('rooms').child($room).child('phase').val() === 'playing'",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "pages": {
              "$r": {
                ".write": "auth != null && root.child('rooms').child($room).child('phase').val() === 'playing' && root.child('rooms').child($room).child('roundKey').val() === $r && root.child('rooms').child($room).child('assign').child(auth.uid).val() === $b && newData.child('by').val() === auth.uid && !root.child('rooms').child($room).child('banned').child(auth.uid).exists()",
                ".validate": "newData.hasChildren(['by', 'type', 'content']) && newData.child('content').isString() && ((newData.child('type').val() === 'draw' && (newData.child('content').val() === '' || (newData.child('content').val().beginsWith('data:image/') && newData.child('content').val().length < 400000))) || ((newData.child('type').val() === 'guess' || newData.child('type').val() === 'word') && newData.child('content').val().length <= 30))"
              }
            }
          }
        },
        "submitted": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "$r": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('roundKey').val() === $r && root.child('rooms').child($room).child('phase').val() === 'playing'",
              ".validate": "newData.val() === true"
            }
          }
        },
        "ready": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('phase').val() === 'result' && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
            ".validate": "newData.val() === true"
          }
        },
        "rejoin": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('class').isString() && !root.child('rooms').child($room).child('players').child(auth.uid).exists() && !root.child('rooms').child($room).child('banned').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 10 && newData.child('at').isNumber()"
          }
        },
        "banned": {
          "$uid": {
            ".validate": "newData.isString()"
          }
        },
        "warn": {
          "$uid": {
            ".validate": "newData.hasChildren(['at', 'msg']) && newData.child('at').isNumber() && newData.child('msg').isString() && newData.child('msg').val().length <= 100"
          }
        },
        "hintUse": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "$uid": {
            "$r": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('phase').val() === 'playing' && root.child('rooms').child($room).child('roundKey').val() === $r && !root.child('rooms').child($room).child('banned').child(auth.uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3 && (!data.exists() || newData.val() > data.val())"
            }
          }
        },
        "watch": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      "$room": {
        ".read": "auth != null && root.child('rooms').child($room).child('class').isString() && root.child('ownerClaims').child(root.child('rooms').child($room).child('class').val()).child(auth.uid).exists()",
        ".write": "auth != null && root.child('rooms').child($room).child('class').isString() && root.child('ownerClaims').child(root.child('rooms').child($room).child('class').val()).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('class').isString() && root.child('rooms').child($room).child('players').child(auth.uid).exists() && !root.child('rooms').child($room).child('banned').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber() && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().beginsWith('data:image/') && newData.child('img').val().length < 60000)) && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 30))"
        }
      }
    },
    "classSecrets": {
      "$code": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length === 64 && $code.length >= 2 && $code.length <= 10 && !$code.contains('-')"
      }
    },
    "ownerClaims": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === root.child('classSecrets').child($code).val()"
        }
      }
    },
    "classes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('ownerClaims').child($code).child(auth.uid).exists()",
        ".validate": "$code.length >= 2 && $code.length <= 10 && !$code.contains('-')"
      }
    }
  }
}